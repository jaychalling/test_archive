{
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "test-archive.com" }],
      "destination": "https://www.test-archive.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/s/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/s/:slug/:value", "destination": "/api/s?slug=:slug&value=:value" },
    { "source": "/s/:slug/:value/", "destination": "/api/s?slug=:slug&value=:value" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
